<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_la_user" model="res.groups">
        <field name="name">Learning Analytics / Faculty</field>
    </record>
    <record id="group_la_manager" model="res.groups">
        <field name="name">Learning Analytics / Curriculum Manager</field>
        <field name="implied_ids" eval="[(4, ref('group_la_user'))]"/>
    </record>
    <record id="group_la_mentor" model="res.groups">
        <field name="name">Learning Analytics / Mentor</field>
        <field name="implied_ids" eval="[(4, ref('group_la_user'))]"/>
    </record>
</odoo>
