<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_otm_student_mentor_list" model="ir.ui.view">
        <field name="name">otm.student.mentor.list</field>
        <field name="model">otm.student.mentor</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="user_id"/>
                <field name="phone"/>
                <field name="student_count"/>
            </list>
        </field>
    </record>

    <record id="view_otm_student_mentor_form" model="ir.ui.view">
        <field name="name">otm.student.mentor.form</field>
        <field name="model">otm.student.mentor</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="user_id"/>
                        <field name="phone"/>
                        <field name="email"/>
                        <field name="active"/>
                    </group>
                    <notebook>
                        <page string="Assigned Students">
                            <field name="student_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="batch_id"/>
                                    <field name="learning_score"/>
                                    <field name="risk_level"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_otm_student_mentor" model="ir.actions.act_window">
        <field name="name">Mentors</field>
        <field name="res_model">otm.student.mentor</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
